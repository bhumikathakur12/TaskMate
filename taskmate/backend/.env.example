# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/taskmate
# For MongoDB Atlas (production), use something like:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/taskmate

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Client
CLIENT_URL=http://localhost:5173
